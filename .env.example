# ---------------------------------------------------------------------------
# admin-backend environment variables
# Copy this file to `.env` and replace the values below with your own.
# Every variable the application reads is listed here.
#
# NOTE: the values below are ILLUSTRATIVE EXAMPLES that show the expected
# format only. They are NOT real credentials. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development            # development | production
PORT=3146                       # HTTP port the server listens on

# Database (PostgreSQL)
DATABASE_URL='postgresql://admin:change_me@localhost:5432/dvpn_admin?schema=public'
DATABASE_REPLICA_URL='postgresql://admin:change_me@localhost:5432/dvpn_admin?schema=public'

# Redis
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_PASS=''                   # Redis AUTH password; leave empty if the server has no password
REDIS_EXPIRY='3600'             # default key TTL in seconds

# Auth / crypto
SECRET_KEY='replace_with_a_long_random_secret'

# Email (SendGrid)
SENDGRID_API_KEY='SG.your_sendgrid_api_key_here'
MAILING_SERVICE_EMAIL='no-reply@example.com'     # verified "from" address

# EVM / chain
SWAGGER_HTTP_HOST='https://evm-rpc.example.com'  # EVM RPC host used by the app (read as evmHost)

# GeoIP (MaxMind)
MAXMIND_DATABASE_PATH='./data/GeoLite2-City.mmdb'  # path to the MaxMind GeoLite2 .mmdb file

# CORS
CORS_ORIGINS='http://localhost:3000,https://admin.example.com'
ALLOWED_ORIGINS='http://localhost:3000,https://admin.example.com'  # legacy

# Feature flags / misc
PLAN_TOGGLER='false'            # toggles plan behaviour (true | false)
GITBOOK_URL='https://docs.example.com'
