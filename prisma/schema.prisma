generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id         String   @id @default(uuid())
  address    String   @unique
  role       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  nodeRequests NodeRequest[]
  activities   Activity[]
}

model NodeRequest {
  id         String   @id @default(uuid())
  orgName    String?  
  email      String? 
  location   String
  nodeAddress String  @unique
  plan       String
  planId     String
  status     Status
  nodeStatus NodeStatus
  bandwidth  String
  address    String
  remoteUrl  String 
  provAddress String  
  action   Boolean  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  requestFor String   

  // Relations
  user User @relation(fields: [address], references: [address])
}

model Activity {
  id        String   @id @default(uuid())
  address   String
  type      String
  action    String
  role      String
  topic     String
  data      Json  
  targetUid    String?  
  userIp       String
  country      String?
  countryCode  String?
  userAgent    String  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [id], references: [id])
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum NodeStatus {
  active
  inactive
}
